---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { Signup } from "../components/Signup.tsx";
import Card from "../components/Card.astro";
import { ServerStatus } from "../components/ServerStatus.tsx";
import Footer from "../components/Footer.astro";
---

<Layout>
  <div class="flex min-h-screen flex-col">
    <main class="grow">
      <Hero />
      <div class="flex justify-center p-4">
        <Signup />
      </div>
      <div class="flex flex-col flex-wrap justify-center gap-6 p-4 md:flex-row">
        <Card
          title="Best Holiday Destination"
          description="See yourself and your family on the best holiday destination"
        />
        <Card
          title="Deals like you've never seen before"
          description="Flights, tours, hotels, and more"
        />
        <Card
          title="A holiday team working for you"
          description="We know how to get you the best deals"
        />
      </div>
      <div class="flex justify-center p-4">
        <ServerStatus client:load />
      </div>
    </main>
    <Footer />
  </div>
</Layout>
